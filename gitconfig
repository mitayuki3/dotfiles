[user]
	name = Yuki MITA
	email = mitayuki3@yahoo.co.jp
[alias]
	co = checkout
	st = status
	b = branch
[core]
	editor = vi
[column]
	ui = auto
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[init]
	defaultBranch = main
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
[push]
	autoSetupRemote = true
	followTags = true
[fetch]
	prune = true
	pruneTags = true
	all = true
